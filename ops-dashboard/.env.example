# Copy to .env.local and fill in your values. .env.local is gitignored.

NEXT_PUBLIC_API_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_FASTIFY_WS_URL="ws://localhost:3000/ops/ws"

# Ops/back-office API key — server-only, deliberately NOT prefixed with NEXT_PUBLIC_.
# Used only by app/api/gw/[...path]/route.ts (runs server-side) to authenticate with
# the Fastify API's guarded /admin/* and /ops/* routes. Must match OPS_API_KEY set on
# the Fastify API host (Railway). Leave unset in local dev — the Fastify-side guard
# no-ops when it's unset, so requests pass through either way.
# OPS_API_KEY="replace-with-a-long-random-secret"
