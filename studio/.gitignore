# Vercel CLI project link and pulled env files
.vercel

# Local secrets. Note the negation: .env.example is documentation, not a
# secret, and must stay committed — the `.env*` pattern would otherwise
# swallow it (Vercel's CLI adds that pattern automatically on `vercel link`).
.env*
!.env.example
