# -----------------------------------------------------------------------------
# studio/ — LegacyLink Studio back office
#
# Copy to `studio/.env` for local dev. Set the same three on the Vercel project.
# This app has its OWN Neon database — do not point it at the QR product's.
# -----------------------------------------------------------------------------

# Pooled connection, used at runtime.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/studio?sslmode=require"

# Unpooled connection, used only by `prisma migrate`. Migrations take advisory
# locks that PgBouncer drops between statements, so they must bypass the pooler.
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/studio?sslmode=require"

# The single password that unlocks the back office.
STUDIO_PASSWORD="change-me-to-something-long"

# Signs the session cookie. Any long random string; changing it logs you out.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STUDIO_SESSION_SECRET="change-me-too"
