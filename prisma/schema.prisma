// =============================================================================
// LegacyLink — Prisma Schema
// PostgreSQL · UUIDv4 keys · soft-delete on Profile · guestbook moderation gate
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMS
// =============================================================================

// Hosting tier. Stored as a native PostgreSQL enum so invalid values are
// rejected at the database level, not just in application code.
enum Plan {
  BASIC    // Included with every plaque purchase
  PREMIUM  // Monthly ($15/mo) or Lifetime ($199)
}

// Discriminates uploaded files so the client can render the correct player
// without inspecting the URL or MIME type at runtime.
enum MediaType {
  PHOTO
  VIDEO
  AUDIO
}

// =============================================================================
// USER
// =============================================================================

model User {
  // UUIDv4 — prevents sequential ID enumeration / scraping of account counts.
  id            String    @id @default(uuid()) @db.Uuid

  email         String    @unique
  name          String

  // bcrypt hash (cost ≥ 12). Raw passwords must never be stored.
  password_hash String

  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  profiles      Profile[]

  @@map("users")
}

// =============================================================================
// PROFILE
// =============================================================================

model Profile {
  id            String    @id @default(uuid()) @db.Uuid

  // ── Routing token ─────────────────────────────────────────────────────────
  // Immutable 6-8 char alphanumeric slug hardcoded into the physical QR plaque.
  // Generated in application code (nanoid with custom alphabet) before insert —
  // NOT auto-incremented — so the value is URL-safe and unpredictable.
  // Once engraved on a tombstone, this value must NEVER be changed.
  short_id      String    @unique @db.VarChar(8)

  // ── Owner ─────────────────────────────────────────────────────────────────
  user_id       String    @db.Uuid
  user          User      @relation(fields: [user_id], references: [id])

  // ── Subject information ───────────────────────────────────────────────────
  full_name     String
  date_of_birth DateTime? @db.Date  // Date only — no timezone ambiguity
  date_of_death DateTime? @db.Date
  epitaph       String?   @db.Text  // Short inscription shown on the profile header
  biography     String?   @db.Text  // Long-form life story; no length cap at DB level
  portrait_url  String?             // CDN URL; validation enforced at app layer

  // ── Access control ────────────────────────────────────────────────────────
  is_private    Boolean   @default(false)
  // 4-digit PIN stored as a bcrypt hash. Null when profile is public.
  privacy_pin   String?

  // ── Plaque fulfilment ─────────────────────────────────────────────────────
  // Tracks physical order state so the dashboard status card stays in sync.
  plaque_status PlaqueStatus @default(ORDER_RECEIVED)

  // ── Scan analytics ────────────────────────────────────────────────────────
  // Denormalised counter — incremented on every QR scan via updateMany.
  // Full per-scan events stay in the analytics module (queue in production).
  scans_count   Int       @default(0)

  // ── Hosting plan ──────────────────────────────────────────────────────────
  plan          Plan      @default(BASIC)

  // ── Soft delete ───────────────────────────────────────────────────────────
  // NULL  → profile is live.
  // Timestamp → profile is tombstoned; excluded from all standard reads via
  // the Prisma client extension defined in lib/db.ts (see below).
  // Hard deletion is a separate, manual, admin-only operation after a
  // configurable retention window (e.g. 90 days).
  deleted_at    DateTime?

  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  // ── Child relations ───────────────────────────────────────────────────────
  timeline             TimelineMilestone[]
  media                MediaAsset[]
  guestbook            GuestbookEntry[]
  guestbook_settings   GuestbookSettings?
  trusted_contributors TrustedContributor[]
  coordinates          GraveCoordinates?
  nav_waypoints        NavigationWaypoint[]
  family_tree          FamilyTreeNode[]
  support_tickets      SupportTicket[]

  // short_id is already unique; the explicit index keeps the planner from
  // falling back to a seq scan when joining from the QR routing layer.
  @@index([short_id])
  // Speeds up "all profiles for this user" queries on the dashboard.
  @@index([user_id])
  // Partial-index equivalent: most reads filter deleted_at IS NULL.
  @@index([deleted_at])

  @@map("profiles")
}

enum PlaqueStatus {
  ORDER_RECEIVED
  ENGRAVING
  SHIPPED
  DELIVERED
}

// =============================================================================
// TIMELINE MILESTONE
// =============================================================================

model TimelineMilestone {
  id          String    @id @default(uuid()) @db.Uuid

  profile_id  String    @db.Uuid
  // Cascade: deleting a profile removes all its timeline events.
  // This is intentional — milestones have no meaning without the parent profile.
  profile     Profile   @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  title       String
  description String?   @db.Text

  // @db.Date stores only the calendar date (no time, no timezone).
  // Historical events are date-precise, not datetime-precise.
  occurred_at DateTime  @db.Date

  // Display order is determined by occurred_at ASC at query time;
  // no manual sort_order column needed here.

  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@index([profile_id])
  @@map("timeline_milestones")
}

// =============================================================================
// MEDIA ASSET
// =============================================================================

model MediaAsset {
  id          String    @id @default(uuid()) @db.Uuid

  profile_id  String    @db.Uuid
  profile     Profile   @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  // Discriminator lets the frontend choose <img>, <video>, or <audio> without
  // parsing the URL or making an extra HEAD request.
  type        MediaType

  // Canonical CDN URL. The actual blob lives in object storage (S3/R2);
  // this column is just the reference.
  url         String

  caption     String?

  // Explicit ordering for the gallery carousel. Lower = shown first.
  sort_order  Int       @default(0)

  // Stored for plan-limit enforcement (BASIC: ≤ 20 photos, no video/audio).
  size_bytes  BigInt?

  created_at  DateTime  @default(now())

  @@index([profile_id])
  // Covers queries like "how much storage is this profile using?"
  @@index([profile_id, type])
  @@map("media_assets")
}

// =============================================================================
// PREMIUM — ENUMS
// =============================================================================

enum FamilyRelation {
  SELF
  PARENT
  SIBLING
  CHILD
  GRANDPARENT
  GRANDCHILD
  SPOUSE
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  STANDARD
  PRIORITY
}

// =============================================================================
// GUESTBOOK ENTRY
// =============================================================================

model GuestbookEntry {
  id           String    @id @default(uuid()) @db.Uuid

  profile_id   String    @db.Uuid
  profile      Profile   @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  author_name  String
  // Optional — collected only if the visitor volunteers it.
  // Never exposed publicly; used only for moderation contact.
  author_email String?

  message      String    @db.Text

  // ── Anti-vandalism gate ───────────────────────────────────────────────────
  // All submissions land here unapproved. The profile owner must explicitly
  // approve before the message appears on the public memorial page.
  // Queries for the public view must always include `WHERE is_approved = true`.
  is_approved  Boolean   @default(false)

  // Soft-flag for spam/abuse without destroying the audit trail.
  is_flagged   Boolean   @default(false)

  created_at   DateTime  @default(now())

  // Covers the public read path: profile_id + approved status filtered together.
  @@index([profile_id, is_approved])
  // Covers the admin moderation queue: all unapproved entries across profiles.
  @@index([is_approved])
  @@map("guestbook_entries")
}

// =============================================================================
// GUESTBOOK SETTINGS  (1-to-1 with Profile)
// =============================================================================

model GuestbookSettings {
  id             String   @id @default(uuid()) @db.Uuid

  profile_id     String   @unique @db.Uuid
  profile        Profile  @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  // When true every new submission waits in the moderation queue before
  // appearing publicly. When false trusted contributors bypass the queue.
  pre_approval   Boolean  @default(true)

  enabled        Boolean  @default(true)

  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@map("guestbook_settings")
}

// =============================================================================
// TRUSTED CONTRIBUTOR
// =============================================================================

model TrustedContributor {
  id         String   @id @default(uuid()) @db.Uuid

  profile_id String   @db.Uuid
  profile    Profile  @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  email      String
  name       String

  added_at   DateTime @default(now())

  // One email address can only be trusted once per profile.
  @@unique([profile_id, email])
  @@index([profile_id])
  @@map("trusted_contributors")
}

// =============================================================================
// GRAVE COORDINATES  (1-to-1 with Profile)
// =============================================================================

model GraveCoordinates {
  id                String   @id @default(uuid()) @db.Uuid

  profile_id        String   @unique @db.Uuid
  profile           Profile  @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  latitude          Float
  longitude         Float

  // Metres radius reported by the device GPS at the moment of scan-to-pin.
  // Stored so administrators can judge whether a re-pin is warranted
  // (e.g. accuracy_radius > 20 m suggests poor signal quality).
  accuracy_radius   Float?

  cemetery_name     String?

  // Micro-navigation: walking path from the main cemetery gate to the plot.
  micro_nav_enabled Boolean  @default(false)
  gate_latitude     Float?
  gate_longitude    Float?

  // Timestamp of the initial scan-to-pin activation, distinct from created_at
  // so we can display "last pinned on <date>" separately from record creation.
  pinned_at         DateTime?

  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@map("grave_coordinates")
}

// =============================================================================
// NAVIGATION WAYPOINT
// Ordered list of walking instructions for the micro-navigation path.
// Each waypoint is a human-readable instruction with an optional GPS anchor
// for precise positioning among dense headstone rows where map routing loses accuracy.
// =============================================================================

model NavigationWaypoint {
  id          String   @id @default(uuid()) @db.Uuid

  profile_id  String   @db.Uuid
  profile     Profile  @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  // Ascending display order for the walking instruction list.
  sort_order  Int      @default(0)

  // Human-readable instruction, e.g. "From the main office, walk 30 m north past the oak tree."
  instruction String   @db.Text

  // Optional GPS anchor for this waypoint. Null = text-only step.
  // Stored so the frontend can show a map pin for each step, not just the final plot.
  latitude    Float?
  longitude   Float?

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([profile_id, sort_order])
  @@map("navigation_waypoints")
}

// =============================================================================
// FAMILY TREE NODE
// =============================================================================

model FamilyTreeNode {
  id                String         @id @default(uuid()) @db.Uuid

  profile_id        String         @db.Uuid
  profile           Profile        @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  full_name         String
  birth_year        Int?
  death_year        Int?
  relation          FamilyRelation

  // Optional hard-link to another LegacyLink Profile (interlink feature).
  linked_profile_id String?        @db.Uuid

  // Original hierarchical parent link (general tree traversal).
  parent_node_id    String?        @db.Uuid
  parent            FamilyTreeNode?  @relation("TreeChildren", fields: [parent_node_id], references: [id])
  children          FamilyTreeNode[] @relation("TreeChildren")

  // Explicit biological parents — used by the graph render engine to draw ancestry lines.
  father_id    String?        @db.Uuid
  father       FamilyTreeNode?  @relation("FatherOf", fields: [father_id], references: [id])
  fatherOf     FamilyTreeNode[] @relation("FatherOf")

  mother_id    String?        @db.Uuid
  mother       FamilyTreeNode?  @relation("MotherOf", fields: [mother_id], references: [id])
  motherOf     FamilyTreeNode[] @relation("MotherOf")

  // Spousal link — drawn as a rose-coloured marriage line in the UI.
  // One partner stores the reference; the other queries spouseOf.
  spouse_id    String?        @db.Uuid
  spouse       FamilyTreeNode?  @relation("Spouses", fields: [spouse_id], references: [id])
  spouseOf     FamilyTreeNode[] @relation("Spouses")

  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt

  @@index([profile_id])
  @@map("family_tree_nodes")
}

// =============================================================================
// SUPPORT TICKET
// =============================================================================

model SupportTicket {
  id                String          @id @default(uuid()) @db.Uuid

  profile_id        String          @db.Uuid
  profile           Profile         @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  // Denormalised for fast lookups without joining through Profile.
  user_id           String          @db.Uuid

  subject           String
  message           String          @db.Text
  status            TicketStatus    @default(OPEN)
  priority          TicketPriority  @default(PRIORITY)

  // SLA clock: set to now() + 2h when ticket is created.
  response_due_at   DateTime?
  first_response_at DateTime?
  resolved_at       DateTime?

  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt

  @@index([profile_id])
  @@index([status])
  @@map("support_tickets")
}
