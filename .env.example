# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/legacylink?schema=public"

# QR base URL (auto-detected in development, set explicitly in production)
# QR_BASE_URL="https://lglk.to/p"

# JWT signing secret — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"
