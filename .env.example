# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.

# Pooled connection — used by the app at runtime (routes through PgBouncer / Neon pooler).
# On Neon: use the pooled endpoint hostname (ep-xxx-pooler.region.aws.neon.tech, port 5432).
DATABASE_URL="postgresql://postgres:password@localhost:5432/legacylink?schema=public"

# Direct connection — used by Prisma CLI for migrations and schema pushes only.
# Must bypass the pooler because advisory locks don't survive connection hand-offs.
# On Neon: use the non-pooled endpoint (ep-xxx.region.aws.neon.tech, port 5432).
# Falls back to DATABASE_URL if unset (fine for local dev with a single Postgres process).
DIRECT_URL="postgresql://postgres:password@localhost:5432/legacylink?schema=public"

# QR base URL (auto-detected in development, set explicitly in production)
# QR_BASE_URL="https://lglk.to/p"

# JWT signing secret — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-secret"

# ── Cloudflare R2 (cloud media storage) ─────────────────────────────────────
# Leave these unset in local dev — the server falls back to /admin/upload (local disk).
# Set NEXT_PUBLIC_USE_CLOUD=true in admin/.env.local to activate the presigned upload flow.
#
# R2 setup checklist (do once per environment):
#   1. Create two R2 buckets in the Cloudflare dashboard:
#        legacylink-entry-<env>    ← raw uploads land here (short-lived)
#        legacylink-delivery-<env> ← Lambda-optimised WebP files served to visitors
#   2. Enable public access (or a custom domain) on the delivery bucket → set CDN_BASE_URL
#   3. Apply infra/entry-bucket-lifecycle.json to the entry bucket:
#        via Cloudflare dashboard: R2 > legacylink-entry-<env> > Settings > Object Lifecycle
#        or via API: aws s3api put-bucket-lifecycle-configuration \
#          --endpoint-url https://<account-id>.r2.cloudflarestorage.com \
#          --bucket legacylink-entry-<env> \
#          --lifecycle-configuration file://infra/entry-bucket-lifecycle.json
#   4. Create an R2 API token with Object Read & Write on both buckets → fill in below
#   5. Update your Lambda S3 trigger prefix filter to: processing-stage/

# R2 endpoint and bucket names
AWS_REGION="auto"
AWS_ENDPOINT_URL_S3="https://<account-id>.r2.cloudflarestorage.com"
AWS_ACCESS_KEY_ID="your-r2-access-key-id"
AWS_SECRET_ACCESS_KEY="your-r2-secret-access-key"
S3_ENTRY_BUCKET="legacylink-entry-prod"
S3_DELIVERY_BUCKET="legacylink-delivery-prod"

# Public base URL for the delivery bucket (R2 custom domain or r2.dev subdomain)
CDN_BASE_URL="https://media.legacylinkstudio.com"
