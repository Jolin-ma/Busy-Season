{
  "name": "legacylink-qr-engine",
  "version": "1.0.0",
  "description": "QR routing and code generation engine for LegacyLink memorials",
  "main": "dist/index.js",
  "scripts": {
    "build": "prisma generate && tsc && npm run build:client",
    "build:client": "esbuild client/background-entry.tsx --bundle --minify --outfile=public/static/background-paths.js --jsx=automatic --loader:.tsx=tsx",
    "dev:client": "esbuild client/background-entry.tsx --bundle --outfile=public/static/background-paths.js --jsx=automatic --loader:.tsx=tsx --watch",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.1068.0",
    "@aws-sdk/client-s3": "^3.1068.0",
    "@aws-sdk/s3-request-presigner": "^3.1068.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^10.1.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/static": "^9.1.3",
    "@fastify/websocket": "^11.2.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "framer-motion": "^12.0.0",
    "geoip-lite": "^2.0.2",
    "nanoid": "3",
    "pg": "^8.21.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^22.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/geoip-lite": "^1.4.4",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.24.0",
    "prisma": "^7.8.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2"
  },
  "private": true
}
